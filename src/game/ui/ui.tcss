Screen {
    layout: vertical;
}

#main_container {
    height: 1fr;
}

#rooms_list {
    width: 40%;
    border: solid $accent;
    overflow: auto;
}

#room_detail {
    width: 60%;
    border: solid $accent;
    overflow: auto;
}

#power_display {
    height: auto;
    border: solid $accent;
}

/* Room list styling */
.room-item {
    width: 100%;
    height: auto;
    padding: 0 1;
}

.room-item:focus {
    background: $panel;
}

/* Room type colors */
.room-type-base {
    color: slategrey;
}

.room-type-generator {
    color: firebrick;
}

.room-type-crafting {
    color: gold;
}

/* Inline fuel input styling */
#fuel_input_inline, .inline-input {
    background: $panel;
    color: $text;
    width: auto;
    padding: 0 1 0 1;
}

.generator-fuel-row {
    padding: 0;
    height: auto;
    align: left top;
    color: $text;
}

.gen-fuel-prefix,
.gen-fuel-suffix {
    color: $text;
    background: transparent;
}

.gen-fuel-prefix {
    width: auto;
    padding-right: 1;
}

.gen-fuel-suffix {
    width: auto;
    padding-left: 1;
}

#generator_footer {
    color: $text;
    height: auto;
}
